# Example only; install a private /etc/kagu-saha/runtime.env outside Git.
# Both services use exactly this file and the same WorkingDirectory.
NODE_ENV=production
DATABASE_URL=postgresql://replace_user:replace_password@127.0.0.1:5432/replace_database?schema=public
APP_ORIGIN=https://saha.example.com
UPLOAD_DIR=/var/lib/kagu-saha/uploads
MEDIA_WORKER_MODE=external
MEDIA_WORKER_HEARTBEAT_FILE=/var/lib/kagu-saha/worker-health/media-worker.json
NEXT_TELEMETRY_DISABLED=1
# First-admin credentials belong only to a one-time bootstrap process.
