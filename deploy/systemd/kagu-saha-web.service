[Unit]
Description=Kagu Saha web application
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/kagu-saha/uploads

[Service]
Type=simple
User=kagu-saha
Group=kagu-saha
WorkingDirectory=/srv/kagu-saha/current
EnvironmentFile=/etc/kagu-saha/runtime.env
ExecStartPre=/opt/node-v24.15.0/bin/node scripts/deploy-preflight.mjs --mode=upgrade --env-file=/etc/kagu-saha/runtime.env --worker-env-file=/etc/kagu-saha/runtime.env
ExecStart=/opt/node-v24.15.0/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=180
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kagu-saha/uploads /var/lib/kagu-saha/worker-health /srv/kagu-saha/current/.next/cache

[Install]
WantedBy=multi-user.target
