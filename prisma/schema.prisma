generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OBSERVER
  PERSONNEL
}

enum DailyTaskStatus {
  PLANNED
  ON_SITE
  COMPLETED
}

enum WorkforceKind {
  PERSONNEL
  CONTRACTOR
  OBSERVER
}

enum UploadSessionStatus {
  OPEN
  PROCESSING
  COMPLETED
  CANCELLED
}

enum TaskEventType {
  TASK_CREATED
  TASK_UPDATED
  PERSON_ASSIGNED
  ARRIVED_SITE
  SITE_VISITED
  LEFT_SITE
  NOTE_ADDED
  FILE_ADDED
}

enum TimelineEventType {
  PROJECT_CREATED
  TASK_CREATED
  TASK_UPDATED
  PERSON_ASSIGNED
  ARRIVED_SITE
  SITE_VISITED
  LEFT_SITE
  NOTE_ADDED
  FILE_ADDED
}

enum OfflinePendingType {
  ARRIVED_SITE
  LEFT_SITE
  NOTE
  FILE
  PHOTO
}

enum OfflinePendingStatus {
  PENDING
  SYNCED
  FAILED
}

enum HeicConversionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImageThumbnailStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique @map("username")
  passwordHash   String    @map("password_hash")
  fullName       String    @map("full_name")
  role           UserRole
  isActive       Boolean   @default(true) @map("is_active")
  lastLatitude   Decimal?  @map("last_latitude") @db.Decimal(10, 7)
  lastLongitude  Decimal?  @map("last_longitude") @db.Decimal(10, 7)
  lastLocationAt DateTime? @map("last_location_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  createdTasks   DailyTask[]            @relation("DailyTaskCreatedBy")
  taskAssignees  DailyTaskAssignee[]
  taskEvents     TaskEvent[]
  timelineEvents ProjectTimelineEvent[]
  projectVisits  ProjectVisit[]
  uploadedFiles  ProjectFile[]
  projectNotes   ProjectNote[]
  sessions       Session[]
  offlineItems   OfflinePendingItem[]
  savedReports   SavedReport[]
  teams          Team[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  info      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@index([name])
  @@map("customers")
}

model Project {
  id            String   @id @default(cuid())
  customerId    String   @map("customer_id")
  name          String
  description   String?
  contactName   String?  @map("contact_name")
  contactPhone  String?  @map("contact_phone")
  city          String?
  location      String?
  googleMapsUrl String?  @map("google_maps_url")
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer       Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  files          ProjectFile[]
  notes          ProjectNote[]
  dailyTasks     DailyTask[]
  taskEvents     TaskEvent[]
  timelineEvents ProjectTimelineEvent[]
  visits         ProjectVisit[]
  savedReports   SavedReport[]

  @@index([customerId])
  @@index([name])
  @@map("projects")
}

model SavedReport {
  id              String   @id @default(cuid())
  reportType      String   @map("report_type")
  title           String
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  projectId       String?  @map("project_id")
  createdByUserId String   @map("created_by_user_id")
  snapshot        Json
  createdAt       DateTime @default(now()) @map("created_at")

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("saved_reports")
}

model ProjectNote {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([userId])
  @@map("project_notes")
}

model DailyTask {
  id              String          @id @default(cuid())
  taskDate        DateTime        @map("task_date") @db.Date
  projectId       String          @map("project_id")
  title           String
  managerNote     String?         @map("manager_note")
  status          DailyTaskStatus @default(PLANNED)
  arrivedAt       DateTime?       @map("arrived_at")
  leftAt          DateTime?       @map("left_at")
  durationMinutes Int?            @map("duration_minutes")
  createdByUserId String          @map("created_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  project        Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy      User                   @relation("DailyTaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignees      DailyTaskAssignee[]
  events         TaskEvent[]
  timelineEvents ProjectTimelineEvent[]
  files          ProjectFile[]

  @@index([taskDate, status])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("daily_tasks")
}

model DailyTaskAssignee {
  id                    String         @id @default(cuid())
  dailyTaskId           String         @map("daily_task_id")
  userId                String         @map("user_id")
  teamId                String?        @map("team_id")
  teamNameSnapshot      String?        @map("team_name_snapshot")
  headcountSnapshot     Int?           @map("headcount_snapshot")
  actualHeadcount       Int?           @map("actual_headcount")
  workforceKindSnapshot WorkforceKind? @map("workforce_kind_snapshot")

  dailyTask DailyTask @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([dailyTaskId, userId])
  @@index([userId])
  @@index([teamId])
  @@map("daily_task_assignees")
}

model Team {
  id                    String              @id @default(cuid())
  name                  String
  representativeUserId  String              @map("representative_user_id")
  extraPersonnelCount   Int                 @map("extra_personnel_count")
  includeRepresentative Boolean             @default(true) @map("include_representative")
  isActive              Boolean             @default(true) @map("is_active")
  effectiveFrom         DateTime            @map("effective_from") @db.Date
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  representative        User                @relation(fields: [representativeUserId], references: [id], onDelete: Restrict)
  assignments           DailyTaskAssignee[]

  @@index([representativeUserId])
  @@map("teams")
}

model TaskEvent {
  id          String        @id @default(cuid())
  dailyTaskId String        @map("daily_task_id")
  projectId   String        @map("project_id")
  userId      String        @map("user_id")
  type        TaskEventType
  note        String?
  latitude    Decimal?      @db.Decimal(10, 7)
  longitude   Decimal?      @db.Decimal(10, 7)
  createdAt   DateTime      @default(now()) @map("created_at")

  dailyTask DailyTask @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([dailyTaskId, createdAt])
  @@index([projectId, createdAt])
  @@index([userId])
  @@map("task_events")
}

model ProjectTimelineEvent {
  id             String            @id @default(cuid())
  projectId      String            @map("project_id")
  dailyTaskId    String?           @map("daily_task_id")
  projectVisitId String?           @map("project_visit_id")
  userId         String?           @map("user_id")
  eventType      TimelineEventType @map("event_type")
  title          String
  description    String?
  fileId         String?           @map("file_id")
  createdAt      DateTime          @default(now()) @map("created_at")

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyTask    DailyTask?    @relation(fields: [dailyTaskId], references: [id], onDelete: SetNull)
  projectVisit ProjectVisit? @relation(fields: [projectVisitId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  file         ProjectFile?  @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([dailyTaskId])
  @@index([projectVisitId])
  @@index([userId])
  @@index([fileId])
  @@map("project_timeline_events")
}

model ProjectVisit {
  id              String   @id @default(cuid())
  projectId       String   @map("project_id")
  visitedByUserId String   @map("visited_by_user_id")
  note            String?
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  visitedAt       DateTime @default(now()) @map("visited_at")
  createdAt       DateTime @default(now()) @map("created_at")

  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitedBy      User                   @relation(fields: [visitedByUserId], references: [id], onDelete: Restrict)
  files          ProjectFile[]
  timelineEvents ProjectTimelineEvent[]

  @@index([projectId, visitedAt])
  @@index([visitedByUserId, visitedAt])
  @@map("project_visits")
}

model ProjectFile {
  id                   String    @id @default(cuid())
  uploadSessionId      String?   @unique @map("upload_session_id")
  projectId            String    @map("project_id")
  dailyTaskId          String?   @map("daily_task_id")
  projectVisitId       String?   @map("project_visit_id")
  uploadedByUserId     String    @map("uploaded_by_user_id")
  originalName         String    @map("original_name")
  mimeType             String    @map("mime_type")
  sizeBytes            BigInt    @map("size_bytes")
  storagePath          String    @map("storage_path")
  thumbnailStoragePath String?   @map("thumbnail_storage_path")
  thumbnailMimeType    String?   @map("thumbnail_mime_type")
  thumbnailSizeBytes   BigInt?   @map("thumbnail_size_bytes")
  thumbnailCreatedAt   DateTime? @map("thumbnail_created_at")
  note                 String?
  createdAt            DateTime  @default(now()) @map("created_at")

  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailyTask      DailyTask?             @relation(fields: [dailyTaskId], references: [id], onDelete: SetNull)
  projectVisit   ProjectVisit?          @relation(fields: [projectVisitId], references: [id], onDelete: SetNull)
  uploadedBy     User                   @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  timelineEvents ProjectTimelineEvent[]
  thumbnailJobs  ImageThumbnailJob[]

  @@index([projectId, createdAt])
  @@index([dailyTaskId])
  @@index([projectVisitId])
  @@index([uploadedByUserId])
  @@map("project_files")
}

model ImageThumbnailJob {
  id                   String               @id @default(cuid())
  projectFileId        String               @map("project_file_id")
  sourceStoragePath    String               @map("source_storage_path")
  thumbnailStoragePath String               @map("thumbnail_storage_path")
  status               ImageThumbnailStatus @default(PENDING)
  attempts             Int                  @default(0)
  lastError            String?              @map("last_error")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  completedAt          DateTime?            @map("completed_at")
  lockedBy             String?              @map("locked_by")
  lockedUntil          DateTime?            @map("locked_until")
  nextAttemptAt        DateTime             @default(now()) @map("next_attempt_at")
  lastAttemptAt        DateTime?            @map("last_attempt_at")

  projectFile ProjectFile @relation(fields: [projectFileId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([projectFileId])
  @@index([status, nextAttemptAt])
  @@map("image_thumbnail_jobs")
}

model HeicConversionJob {
  id                String               @id @default(cuid())
  projectId         String               @map("project_id")
  dailyTaskId       String?              @map("daily_task_id")
  projectVisitId    String?              @map("project_visit_id")
  uploadedByUserId  String               @map("uploaded_by_user_id")
  originalName      String               @map("original_name")
  targetName        String               @map("target_name")
  tempStoragePath   String               @map("temp_storage_path")
  targetStoragePath String               @map("target_storage_path")
  note              String?
  timelineTitle     String               @map("timeline_title")
  status            HeicConversionStatus @default(PENDING)
  attempts          Int                  @default(0)
  lastError         String?              @map("last_error")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  completedAt       DateTime?            @map("completed_at")
  uploadSessionId   String?              @unique @map("upload_session_id")
  stagingCleanedAt  DateTime?            @map("staging_cleaned_at")
  lockedBy          String?              @map("locked_by")
  lockedUntil       DateTime?            @map("locked_until")
  nextAttemptAt     DateTime             @default(now()) @map("next_attempt_at")
  lastAttemptAt     DateTime?            @map("last_attempt_at")

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, stagingCleanedAt, nextAttemptAt], map: "heic_cleanup_queue_idx")
  @@index([projectId])
  @@index([dailyTaskId])
  @@index([projectVisitId])
  @@index([uploadedByUserId])
  @@map("heic_conversion_jobs")
}

model UploadSession {
  id               String              @id @default(cuid())
  uploadedByUserId String              @map("uploaded_by_user_id")
  projectId        String              @map("project_id")
  dailyTaskId      String?             @map("daily_task_id")
  projectVisitId   String?             @map("project_visit_id")
  clientUploadId   String              @map("client_upload_id")
  originalName     String              @map("original_name")
  mimeType         String              @map("mime_type")
  sizeBytes        BigInt              @map("size_bytes")
  offsetBytes      BigInt              @default(0) @map("offset_bytes")
  tempStoragePath  String              @map("temp_storage_path")
  stagingCleanedAt DateTime?           @map("staging_cleaned_at")
  status           UploadSessionStatus @default(OPEN)
  projectFileId    String?             @map("project_file_id")
  note             String?
  lockedBy         String?             @map("locked_by")
  lockedUntil      DateTime?           @map("locked_until")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  expiresAt        DateTime            @map("expires_at")
  completedAt      DateTime?           @map("completed_at")

  @@unique([uploadedByUserId, clientUploadId])
  @@index([status, expiresAt])
  @@index([stagingCleanedAt, status, updatedAt], map: "upload_staging_cleanup_idx")
  @@index([projectId])
  @@map("upload_sessions")
}

model OfflinePendingItem {
  id           String               @id @default(cuid())
  userId       String               @map("user_id")
  type         OfflinePendingType
  status       OfflinePendingStatus @default(PENDING)
  clientItemId String               @unique @map("client_item_id")
  payload      Json
  lastError    String?              @map("last_error")
  createdAt    DateTime             @default(now()) @map("created_at")
  syncedAt     DateTime?            @map("synced_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("offline_pending_items")
}
