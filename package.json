{
  "name": "kagu-saha",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "build:worker": "tsc --project tsconfig.worker.json",
    "worker:media": "node --env-file-if-exists=.env dist/media-worker/scripts/media-worker.js",
    "start": "next start",
    "lint": "eslint app components lib scripts tests *.mjs *.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import ./scripts/register-typescript.mjs --test tests/*.test.mjs scripts/tests/*.test.mjs",
    "admin:bootstrap": "node scripts/admin-bootstrap.mjs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "queue:existing-heic": "node scripts/queue-existing-heic.mjs",
    "compress:existing-images": "node scripts/compress-existing-images.mjs",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-slot": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic-convert": "^2.1.0",
    "lucide-react": "^0.511.0",
    "next": "^15.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.18",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "fake-indexeddb": "^6.2.5",
    "prisma": "^6.8.2",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18",
    "deepmerge-ts": "^8.0.0"
  }
}
